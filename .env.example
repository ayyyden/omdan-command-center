# Omdan Command Center — environment variables
# Copy to .env.local for local dev, and set the same in Vercel project settings
# (Production + Preview) for deployment. Never commit real values.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Nodemailer / SMTP) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Assistant / Lia bridge shared secret ─────────────────────────────────────
# Must match CRM_ASSISTANT_SECRET in lia-bridge/.env — authenticates requests
# from the lia-bridge VPS service to /api/assistant/* and /api/meta-leads/rollover.
ASSISTANT_SECRET=
ASSISTANT_OWNER_EMAIL=

# ── Google Maps (address autocomplete) ───────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Google Calendar (Meta Lead Jobs) ─────────────────────────────────────────
# Service account credentials — see the Meta Lead Jobs setup guide for how to
# create these in Google Cloud Console and share the two target calendars with
# the service account's email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
META_LEADS_MAIN_CALENDAR_ID=
META_LEADS_CALLBACK_CALENDAR_ID=
